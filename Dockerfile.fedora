# Build stage
FROM rust:1.82-slim AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libasound2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Cache dependencies layer
COPY Cargo.toml Cargo.lock ./
COPY crates/iradio-bridge/Cargo.toml crates/iradio-bridge/
RUN mkdir -p crates/iradio-bridge/src && \
    echo 'fn main(){}' > crates/iradio-bridge/src/main.rs && \
    cargo build --release && \
    rm -rf crates/iradio-bridge/src

# Full build
COPY . .
RUN cargo build --release

# Runtime stage
FROM fedora:41 AS runtime

RUN dnf install -y alsa-lib && dnf clean all

COPY --from=builder /build/target/release/iradio-bridge /usr/local/bin/iradio-bridge
COPY systemd/iradio-bridge.service /etc/systemd/system/iradio-bridge.service
COPY config.example.toml /etc/iradio/config.toml

RUN mkdir -p /var/lib/iradio

EXPOSE 8765

ENTRYPOINT ["/usr/local/bin/iradio-bridge"]
CMD ["--config", "/etc/iradio/config.toml"]
